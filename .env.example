# Copy the values below to your local environment or appsettings.Local.json.
# This file is documentation only; ASP.NET Core does not load .env files by default.
ConnectionStrings__StreamingDbContext=Host=localhost;Port=5432;Database=streaming;Username=postgres;Password=change-me
JwtOptions__SecretKey=replace-with-a-long-random-secret
JwtOptions__Audience=streaming-project
JwtOptions__Issuer=streaming-project
JwtOptions__ExpireHours=12

POSTGRES_DB=streaming
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=replace-with-a-long-random-secret