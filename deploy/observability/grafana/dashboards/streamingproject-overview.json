{
  "uid": "streamingproject-overview",
  "title": "StreamingProject Overview",
  "tags": [
    "streamingproject",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend Status",
      "description": "Shows whether Prometheus can reach the streaming backend.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"streaming-backend\"}",
          "legendFormat": "Backend"
        }
      ],
      "gridPos": {
         "h": 8,
         "w": 8,
         "x": 0,
         "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
               {
                 "color": "red",
                 "value": null
               },
               {
                 "color": "green",
                 "value": 1
               }
             ]
           }
         },
         "overrides": []
       },
       "options": {
         "reduceOptions": {
           "values": false,
           "calcs": [
             "lastNotNull"
           ],
           "fields": ""
       },
       "orientation": "auto",
       "colorMode": "value",
       "graphMode": "none",
       "justifyMode": "auto",
       "textMode": "auto"
       }
     },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Streams",
      "description": "Current number of active streaming sessions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "streaming_active_streams or vector(0)",
          "legendFormat": "Active streams"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP Requests per Second",
      "description": "Number of HTTP requests handled by the backend per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"streaming-backend\"}[5m]))",
          "legendFormat": "Requests/sec"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Errors per Second",
      "description": "Number of HTTP 4xx and 5xx responses per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"streaming-backend\",http_response_status_code=~\"4..|5..\"}[5m])) or vector(0)",
          "legendFormat": "HTTP errors/sec"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Average HTTP Latency",
      "description": "Average HTTP response time of the backend.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_sum{job=\"streaming-backend\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"streaming-backend\"}[5m]))) * 1000 or vector(0)",
          "legendFormat": "Average latency"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Streams Started per Second",
      "description": "Number of streaming sessions started per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(streaming_streams_started_total[5m]) or vector(0)",
          "legendFormat": "Streams started/sec"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Streams Ended per Second",
      "description": "Number of streaming sessions ended per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(streaming_streams_ended_total[5m]) or vector(0)",
          "legendFormat": "Streams ended/sec"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
