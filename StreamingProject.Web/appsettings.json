{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StreamingDbContext": ""
  },
  
  
  "JwtOptions": {
    "SecretKey": "",
    "Audience": "streaming-project",
    "Issuer": "streaming-project",
    "ExpireHours": "12"
  },
  
  "AuthorizationOptions": {
    "RolePermissions": [
      { "Role":  "Admin", 
        "Permissions":  ["Create", "Read", "Update", "Delete"]
      },
      { "Role":  "User", 
        "Permissions":  ["Read", "Create"]}
    ]
  }
  
  
}
